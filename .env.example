# QueueForge Environment Configuration Template

# Server & Networking
QF_HTTP_ADDR=0.0.0.0:8080
QF_METRICS_ADDR=127.0.0.1:9090
QF_ALLOWED_ORIGINS=*

# PostgreSQL Database (Authority Store)
QF_DATABASE_URL=postgres://postgres:postgres@localhost:5435/queueforge?sslmode=disable
QF_DATABASE_MAX_CONNS=20
QF_DATABASE_MIN_CONNS=2
QF_DATABASE_TLS_MODE=disable

# Logging
QF_LOG_LEVEL=info
QF_LOG_FORMAT=json

# Queue & Routing
QF_ALLOWED_QUEUES=default,notifications,background,maintenance

# Reliability & Leases
QF_DEFAULT_LEASE_DURATION=60s
QF_LEASE_RENEW_INTERVAL=20s
QF_WORKER_HEARTBEAT_INTERVAL=10s
QF_CLAIM_POLL_INTERVAL=250ms
QF_RECOVERY_INTERVAL=5s

# Retries & Backoff
QF_DEFAULT_MAX_ATTEMPTS=5
QF_RETRY_BASE_DELAY=1s
QF_RETRY_MAX_DELAY=15m
QF_DEFAULT_JOB_TIMEOUT_SECONDS=300
QF_MAX_JOB_TIMEOUT_SECONDS=3600

# Scheduling & Retention
QF_SCHEDULER_INTERVAL=1s
QF_SCHEDULE_MISFIRE_GRACE=30s
QF_MAX_SCHEDULE_HORIZON=8760h
QF_IDEMPOTENCY_TTL=24h
QF_TERMINAL_JOB_RETENTION=720h
QF_RETENTION_INTERVAL=1h

# Size Caps
QF_MAX_REQUEST_BYTES=1048576
QF_MAX_PAYLOAD_BYTES=262144
QF_SHUTDOWN_TIMEOUT=30s
